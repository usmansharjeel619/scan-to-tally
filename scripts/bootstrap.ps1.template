<#
    Scan to Tally -- one-shot installer for the Tally machine.

    RUN IN AN ADMINISTRATOR POWERSHELL.

    Downloads the connector, works out which company Tally has open, writes the
    config, registers the service and starts it.

    Nothing inbound is opened. The connector dials OUT to the relay, which is
    the whole point: Tally's XML gateway has no authentication and must never
    be reachable from a network.

    Re-run with -NoDiagnostics once Phase 0 is finished to close the read-only
    query channel.
#>

param(
    [string] $Company = "",
    [switch] $NoDiagnostics
)

$ErrorActionPreference = "Stop"

$base = "__BASE_URL__"
$dir  = "C:\ScanToTally"

# --- must be admin ----------------------------------------------------------

$principal = New-Object Security.Principal.WindowsPrincipal(
    [Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "Run this in an Administrator PowerShell." -ForegroundColor Red
    Write-Host "Right-click Windows PowerShell and choose 'Run as administrator'."
    exit 1
}

# TLS 1.2 for older Windows PowerShell defaults.
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Write-Host ""
Write-Host "Scan to Tally - connector setup" -ForegroundColor Cyan
Write-Host ""

# --- download ---------------------------------------------------------------

New-Item -ItemType Directory -Force -Path $dir | Out-Null

Write-Host "1. Downloading" -ForegroundColor White
foreach ($f in @("connector.exe", "install-connector.ps1", "tally-probe.ps1")) {
    Write-Host ("   {0}" -f $f) -NoNewline
    Invoke-WebRequest -Uri "$base/$f" -OutFile (Join-Path $dir $f) -UseBasicParsing
    $size = (Get-Item (Join-Path $dir $f)).Length
    Write-Host ("  ({0:N0} bytes)" -f $size) -ForegroundColor Green
}

# --- find the open company --------------------------------------------------

Write-Host ""
Write-Host "2. Asking Tally which company is open" -ForegroundColor White

function Get-TallyCompanies {
    <#
        Tries several shapes, because which one works depends on the Tally
        version and how the company is configured. The first that returns
        names wins; the raw reply from the last attempt is kept so a total
        failure can still be diagnosed rather than guessed at.
    #>
    param([ref] $RawOut)

    $attempts = @(
        @{ name = "collection/Company"; body = @'
<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Collection</TYPE><ID>STT_Co</ID></HEADER><BODY><DESC>
<STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES>
<TDL><TDLMESSAGE><COLLECTION NAME="STT_Co" ISMODIFY="No"><TYPE>Company</TYPE>
<NATIVEMETHOD>NAME</NATIVEMETHOD></COLLECTION></TDLMESSAGE></TDL>
</DESC></BODY></ENVELOPE>
'@ },
        @{ name = "report/List of Companies"; body = @'
<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Data</TYPE><ID>List of Companies</ID></HEADER><BODY><DESC>
<STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES>
</DESC></BODY></ENVELOPE>
'@ },
        @{ name = "collection/fetch NAME"; body = @'
<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Collection</TYPE><ID>STT_Co2</ID></HEADER><BODY><DESC>
<STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES>
<TDL><TDLMESSAGE><COLLECTION NAME="STT_Co2" ISMODIFY="No"><TYPE>Company</TYPE>
<FETCH>NAME</FETCH></COLLECTION></TDLMESSAGE></TDL>
</DESC></BODY></ENVELOPE>
'@ }
    )

    foreach ($a in $attempts) {
        try {
            $resp = Invoke-WebRequest -Uri "http://127.0.0.1:9000" -Method Post `
                        -Body $a.body -ContentType "text/xml" -TimeoutSec 20 -UseBasicParsing
            $RawOut.Value = "[" + $a.name + "]`r`n" + $resp.Content

            $names = @()
            foreach ($pat in @('<NAME>(.*?)</NAME>', 'NAME="([^"]+)"')) {
                $names = [regex]::Matches($resp.Content, $pat) |
                         ForEach-Object { $_.Groups[1].Value.Trim() } |
                         Where-Object { $_ -ne "" } |
                         Select-Object -Unique
                if ($names.Count -gt 0) { break }
            }
            if ($names.Count -gt 0) {
                Write-Host ("   (matched via " + $a.name + ")") -ForegroundColor DarkGray
                return @($names)
            }
        }
        catch {
            $RawOut.Value = "[" + $a.name + "] EXCEPTION: " + $_.Exception.Message
        }
    }
    return @()
}

if (-not $Company) {
    $raw = ""
    $names = Get-TallyCompanies ([ref] $raw)

    if ($names.Count -eq 1) {
        $Company = $names[0]
        Write-Host "   Found: $Company" -ForegroundColor Green
    }
    elseif ($names.Count -gt 1) {
        Write-Host "   More than one company is open:" -ForegroundColor Yellow
        for ($i = 0; $i -lt $names.Count; $i++) {
            Write-Host ("     [{0}] {1}" -f $i, $names[$i])
        }
        $pick = Read-Host "   Which one should the warehouse post into? (number)"
        $Company = $names[[int]$pick]
        Write-Host "   Using: $Company" -ForegroundColor Green
    }
    else {
        # Not fatal. Tally is clearly answering, so the query shape is what is
        # wrong -- which is a Phase 0 finding, not a reason to stop installing.
        Write-Host "   Tally answered but returned no company names." -ForegroundColor Yellow
        $dump = Join-Path $dir "company-probe.txt"
        Set-Content -Path $dump -Value $raw -Encoding UTF8
        Write-Host "   Saved its reply to $dump" -ForegroundColor DarkGray
        Write-Host ""
        Write-Host "   Type the company name EXACTLY as Tally spells it." -ForegroundColor Cyan
        Write-Host "   (Top-left of the Tally window, or Alt+F3 > Select Company.)"
        $Company = (Read-Host "   Company name").Trim()
    }
}
else {
    Write-Host "   Using the name given: $Company" -ForegroundColor Green
}

if (-not $Company) {
    Write-Host ""
    Write-Host "No company name, so there is nothing to configure." -ForegroundColor Red
    Write-Host "Run this again and type the name when asked, or pass -Company 'EXACT NAME'."
    exit 1
}

# --- install ----------------------------------------------------------------

Write-Host ""
Write-Host "3. Installing the service" -ForegroundColor White

$installArgs = @{
    RelayUrl    = "__RELAY_URL__"
    Secret      = "__SECRET__"
    Company     = $Company
    Diagnostics = (-not $NoDiagnostics)
}

& (Join-Path $dir "install-connector.ps1") @installArgs
