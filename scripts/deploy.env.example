# Where this project deploys to, and the unguessable part of its download URL.
#
# Copy to scripts/deploy.env and fill in. That file is gitignored: it holds the
# address of a live server and the download path that serves the installer, and
# the installer carries the connector secret once generated. Publishing the path
# is enough to hand somebody the installer, so it never goes in a tracked file.

# The machine that builds the APK and serves the downloads.
BUILD_HOST="root@198.51.100.10"

# The public relay, as the handsets and the connector reach it.
RELAY_ORIGIN="https://relay.example.com"

# The random path segment the installer and APK are served under.
DOWNLOAD_PATH="replace-with-the-32-character-path"
